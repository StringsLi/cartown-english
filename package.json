{
  "name": "little-english-book",
  "version": "0.1.0",
  "private": true,
  "description": "Little English Book | Parent-child English picture book mini program.",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "node scripts/clean-build.mjs mp-weixin && uni build -p mp-weixin && node scripts/check-mp-package-size.mjs",
    "generate:car-audio": "node scripts/generate-car-name-audio.mjs",
    "generate:phrase-audio": "node scripts/generate-phrase-audio.mjs",
    "type-check": "vue-tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "check:release": "node scripts/validate-content.mjs --release",
    "test:adventures": "node scripts/test-adventures.cjs",
    "test": "npm run type-check && npm run validate:content && npm run test:adventures && npm run test:learning && npm run test:record-export && npm run test:record-capture",
    "test:learning": "node scripts/test-learning.cjs",
    "test:record-export": "node scripts/test-record-export.cjs",
    "test:record-capture": "node scripts/test-record-capture.cjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-1000920260626810",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-1000920260626810",
    "pinia": "^2.3.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-1000920260626810",
    "@types/node": "^22.10.5",
    "sass": "^1.83.0",
    "typescript": "^5.7.2",
    "vite": "8.1.0",
    "vue-tsc": "^2.2.0"
  }
}
